<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Deliberately no request/access logging: TransitOS keeps no personal
         data. Only lifecycle and error logs are emitted. -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
